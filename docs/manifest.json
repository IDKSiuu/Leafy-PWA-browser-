{
  "name": "Leafy Browser",
  "short_name": "Leafy",
  "description": "A lightweight, installable mini browser with tabs, bookmarks, history, and themes.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
